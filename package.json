{
  "name": "starlight-package-managers-monorepo",
  "version": "0.8.0",
  "license": "MIT",
  "description": "Quickly display npm related commands for multiple package managers in your Starlight documentation site.",
  "author": "HiDeoo <github@hideoo.dev> (https://hideoo.dev)",
  "type": "module",
  "scripts": {
    "lint": "pnpm -r lint",
    "format": "prettier -w --cache --ignore-unknown .",
    "version": "pnpm changeset version && pnpm i --no-frozen-lockfile"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@hideoo/eslint-config": "^5.0.0",
    "@hideoo/prettier-config": "^2.0.2",
    "@hideoo/tsconfig": "^2.0.4",
    "astro": "^6.0.4",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "private": true,
  "sideEffects": false,
  "keywords": [
    "astro-component",
    "withastro",
    "starlight",
    "package",
    "manager",
    "npm"
  ],
  "homepage": "https://github.com/HiDeoo/starlight-package-managers",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiDeoo/starlight-package-managers.git"
  },
  "bugs": "https://github.com/HiDeoo/starlight-package-managers/issues"
}
