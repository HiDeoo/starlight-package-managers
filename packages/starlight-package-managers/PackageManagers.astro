---
import PackageManagersCompact from './PackageManagersCompact.astro'
import PackageManagersTabs from './PackageManagersTabs.astro'
import type { CommandOptions, CommandType, PackageManager } from './pkg'

export type PackageManagersProps = Props

interface Props extends CommandOptions {
  frame?: 'none' | 'terminal'
  icons?: boolean
  pkg?: string | undefined
  pkgManagers?: PackageManager[]
  title?: string | undefined
  type?: CommandType
  variant?: 'tabs' | 'compact'
}

const { variant = 'tabs', ...props } = Astro.props
---

{variant === 'compact' ? <PackageManagersCompact {...props} /> : <PackageManagersTabs {...props} />}
